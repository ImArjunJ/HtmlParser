function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

set(test_dir "${HTMLPARSER_BINARY_DIR}/consumer-tests/${HTMLPARSER_CONSUMER_MODE}")
set(prefix "${test_dir}/prefix")
set(config_args)
set(ctest_config_args)
if(HTMLPARSER_CONFIG)
    list(APPEND config_args --config "${HTMLPARSER_CONFIG}")
    list(APPEND ctest_config_args --build-config "${HTMLPARSER_CONFIG}")
endif()
set(args -S "${HTMLPARSER_SOURCE_DIR}/tests/cmake/consumer" -B "${test_dir}/build"
    -G "${HTMLPARSER_GENERATOR}" -DCMAKE_CXX_COMPILER=${HTMLPARSER_CXX_COMPILER}
    -DCMAKE_BUILD_TYPE=${HTMLPARSER_CONFIG})
if(HTMLPARSER_CONSUMER_MODE STREQUAL "installed")
    run("${CMAKE_COMMAND}" --install "${HTMLPARSER_BINARY_DIR}" --prefix "${prefix}" ${config_args})
    list(APPEND args -DCMAKE_PREFIX_PATH=${prefix})
    if(WIN32)
        set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
    endif()
else()
    list(APPEND args -DHTMLPARSER_SOURCE_DIR=${HTMLPARSER_SOURCE_DIR})
endif()
run("${CMAKE_COMMAND}" ${args})
run("${CMAKE_COMMAND}" --build "${test_dir}/build" ${config_args} --parallel 2)
run("${CMAKE_CTEST_COMMAND}" --test-dir "${test_dir}/build" ${ctest_config_args} --output-on-failure)
